# start.ps1 does not implicitly execute this file. Set environment variables in the shell.
ZHUOZHI_MODE=demo
ZHUOZHI_DATA_DIR=./data
ZHUOZHI_MAX_UPLOAD_MB=30
ZHUOZHI_MAX_PAGES=120
ZHUOZHI_WORKER_ENABLED=true
# Demo-only bearer -> user + allowed course IDs, NEVER use these public demo tokens in production.
ZHUOZHI_DEMO_IDENTITIES={"demo-token":{"user_id":"user-demo","course_ids":["course-demo"]},"other-token":{"user_id":"user-other","course_ids":["course-other"]},"author-token":{"user_id":"user-demo","course_ids":["course-demo"],"permissions":["assessment:review","content:write"]}}
# In integrated mode inject your A1/A2 AccessProvider in register_modules().
# Optional legacy PPT converter; modern PPTX needs no Office installation.
# ZHUOZHI_SOFFICE=C:/Program Files/LibreOffice/program/soffice.exe
# Optional Node artifact renderer location (auto-discovered in Codex desktop).
# ZHUOZHI_ARTIFACT_MODULE=C:/path/to/node_modules/@oai/artifact-tool/dist/artifact_tool.mjs
# ZHUOZHI_NODE=node
# Optional TrueType/TrueType collection path for embedded Chinese exam PDF fonts.
# ZHUOZHI_PDF_FONT=C:/Windows/Fonts/msyh.ttc
# Optional local/remote chat-completions endpoint (include the full /v1/chat/completions path).
# ZHUOZHI_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions
# ZHUOZHI_CHAT_MODEL=your-installed-model
# ZHUOZHI_CHAT_API_KEY=
# Optional trusted sprite-generation adapter; unrelated to the text chat endpoint.
# Must accept/return the JSON contract in docs/08_迷你宠物图集与生成.md.
# ZHI_PET_SPRITE_URL=https://your-trusted-adapter.example/generate
# ZHI_PET_SPRITE_API_KEY=
